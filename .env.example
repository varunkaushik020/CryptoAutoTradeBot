# Delta Exchange Testnet (paper trading)
# Create keys at https://testnet.delta.exchange -> Profile -> API Keys
DELTA_API_KEY=your_testnet_api_key
DELTA_API_SECRET=your_testnet_api_secret
DELTA_BASE_URL=https://testnet-api.delta.exchange

# MongoDB (local default, or paste your Atlas SRV URI)
MONGO_URI=mongodb://localhost:27017/forexbot

# Bot config
TRADING_SYMBOL=BTCUSDT
TRADE_QUANTITY=1
CHECK_INTERVAL_MINUTES=5

# EMA settings
EMA_FAST=9
EMA_SLOW=21

# RSI settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Market news + economic calendar (all optional — sensible defaults in config.py)
# ForexFactory has no news API, so headlines are aggregated from forex/crypto RSS feeds;
# the forecast/calendar table uses ForexFactory's official weekly JSON.
NEWS_ENABLED=true
NEWS_AI_CONTEXT=true          # feed upcoming events + headlines into the AI each tick
NEWS_BLACKOUT_MIN=15          # skip opening NEW trades within N min of a High-impact event (0 = off)
NEWS_CURRENCIES=USD,EUR,GBP,JPY,CNY
NEWS_REFRESH_SEC=180

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI brain provider ---------------------------------------------------- #
# Priority: Gemini (GEMINI_API_KEY) → Anthropic API (ANTHROPIC_API_KEY)
#           → local Claude Code CLI → mechanical engine.
GEMINI_API_KEY=your_gemini_key
AI_ENABLED=true
AI_MODE=decide                 # decide | refine | advisory
# Model used for BOTH the Anthropic SDK path and the `claude -p --model` CLI path.
AI_MODEL=claude-opus-4-8

# --- OpenRouter / Ox Alpha — FIRST rung for all AI work -------------------- #
# oxalpha.site is a TRACKER PAGE, not a provider: the model is served by
# OpenRouter as `stealth/ox-alpha` (free, $0 in/out, 1M context, OpenAI-compatible).
# It is a STEALTH model — anonymous provider, no SLA, can be withdrawn without
# notice, and OpenRouter Stealth Program terms allow prompt retention. It leads
# the chain rather than replacing it, so a withdrawal degrades instead of breaking.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=stealth/ox-alpha

# --- Loop cadence --------------------------------------------------------- #
# CHECK_INTERVAL_SECONDS wins over _MINUTES when > 0. 30 = ~2,880 ticks/day,
# which is only affordable while the free first rung is answering.
CHECK_INTERVAL_MINUTES=5
CHECK_INTERVAL_SECONDS=0

# --- AgentRouter (Claude reseller, https://agentrouter.org) ---------------- #
# Anthropic-compatible, but it authenticates ONLY Claude-Code-style clients: the
# Python SDK is rejected with `unauthorized_client_error`, so the bot reaches it
# through the `claude -p` CLI. ai_brain injects these into that subprocess only,
# so your interactive Claude Code sessions stay on your subscription — and that
# subscription CLI is the final fallback when the router is down or out of credit.
# This token can only reach: claude-opus-5, claude-opus-4-8.
# COST: each CLI call ships ~45k tokens of system prompt (~$0.28/call measured),
# which is why Gemini — not this — is the primary provider for the 5-min loop.
AGENTROUTER_API_KEY=sk-your-agentrouter-key
AGENTROUTER_BASE_URL=https://agentrouter.org
AGENTROUTER_MODEL=claude-opus-4-8
# Spend guard: max ~$0.28 router calls per UTC day. 0 = uncapped.
AGENTROUTER_DAILY_CALL_CAP=120

# Provider chains (defined in backend/bot/ai_brain.py):
#   analysis / trading loop : openrouter -> groq -> gemini -> agentrouter -> cli
#   news brief              : openrouter -> agentrouter -> groq -> gemini-pro -> cli
